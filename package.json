{
  "name": "dumbact-demo-pack",
  "version": "0.5.0",
  "private": true,
  "description": "Dumbact runtime, module graph support, CDN/library compatibility demos, Express demos, browser tests, fuzz tests, and benchmarks.",
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:all",
    "test:runtime": "node test-runtime.js",
    "test:demo": "node test-demo.mjs",
    "test:browser": "node test-browser.mjs",
    "test:fuzz": "node test-fuzz.mjs",
    "test:bench": "node test-bench.mjs",
    "test:all": "node test-all.mjs",
    "serve:notes": "node demo-notes.mjs",
    "serve:sse": "node demo-sse.mjs",
    "serve:votes": "node demo-vote.mjs",
    "serve:palette": "node demo-palette.mjs",
    "serve:grocery": "node demo-grocery/server.mjs",
    "serve:queue": "node demo-queue/server.mjs",
    "serve": "node serve.mjs",
    "test:fuzzbench": "node test-fuzz-bench.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "none",
    "bracketSameLine": true,
    "singleAttributePerLine": false,
    "proseWrap": "never"
  }
}
