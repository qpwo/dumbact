{
  "name": "dumbact-demo-pack",
  "version": "0.5.0",
  "private": true,
  "description": "Dumbact runtime, module graph support, CDN/library compatibility demos, Express demos, browser tests, fuzz tests, and benchmarks.",
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:all",
    "test:runtime": "node dumbact.test.js",
    "test:demo": "node tests/demo-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:fuzz": "node tests/fuzz.mjs",
    "test:bench": "node tests/bench.mjs",
    "test:all": "node tests/run-all.mjs",
    "serve:notes": "node demos/07-api-notes-paired.server.mjs",
    "serve:sse": "node demos/08-sse-metrics-paired.server.mjs",
    "serve:votes": "node demos/09-vote-wall-singlefile.server.mjs",
    "serve:palette": "node demos/10-command-palette-singlefile.server.mjs",
    "serve:grocery": "node demos/14-multifile-jsx/server.mjs",
    "serve:queue": "node demos/15-multifile-tsx/server.mjs",
    "serve": "node serve.mjs",
    "test:fuzzbench": "node tests/fuzz-bench.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "lodash": "4.17.21"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
